//Problem - 2 
//Types of Inheritance
//1.2 --  Multilevel inheritance

class Vehicle {
public:
    void start() {
        cout << "Vehicle Start" << "\n";
    }
};

class Car : public Vehicle {   // inheritance added
public:
    void drive() {
        cout << "Car is running" << "\n";
    }
};

class speedometer : public Car {
public: 
void speed() {
        cout << "Car is running at 60km/hr " << "\n";
    }
};

int main() {

    speedometer obj1;
    obj1.start();
    obj1.drive();
    obj1.speed();
    return 0;
}



#include <iostream>
using namespace std;

//Problem - 3 
//Types of Inheritance
//1.3 --  hierarchical inheritance

class Vehicle {
public:
    void start() {
        cout << "Vehicle Start" << "\n";
    }
};

class Bike : public Vehicle{
public:
   void drive() {
       cout << "Bike is running..." << "\n";
   }
};
class Car : public Vehicle {   // inheritance added
public:
    void drive() {
        cout << "Car is running" << "\n";
    }
};


int main() {

    Car c;
    Bike b;
    c.start();
    c.drive();
    b.start();
    b.drive();
    return 0;
}

