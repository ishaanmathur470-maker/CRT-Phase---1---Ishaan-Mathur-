#include <iostream>
using namespace std;

// Problem 1
// Single Inheritance

class Vehicle {
public:
    void start() {
        cout << "Vehicle Start" << "\n";
    }
};

class Car : public Vehicle {   // inheritance added
public:
    void drive() {
        cout << "Car is running" << "\n";
    }
};

int main() {

    Car obj1;

    obj1.drive();
    obj1.start();

    return 0;
}


